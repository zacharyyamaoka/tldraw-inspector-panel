{
  "name": "tldraw_styling_lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:pixels": "node tests/stock_pixels.mjs",
    "test:inspector": "node tests/inspector_smoke.mjs",
    "check": "tsc -b && vitest run && node tests/stock_pixels.mjs && node tests/inspector_smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tldraw/assets": "5.3.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "tldraw": "5.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "tldraw-inspector",
      "type": "registry:ui",
      "title": "tldraw Inspector",
      "description": "The Figma-shaped style panel for stock tldraw@5.3.2 (M2): a React-free field model (inspectorModel.ts), the meta-merge overrides contract (overrides.ts), the paint seam + rounded-rect (configuredUtils.ts), a scrubbable NumberField (ScrubNumber.tsx) and the shadcn/Base UI view (Inspector.tsx) that renders it through tldraw's own `components.StylePanel` seam. Consumed by copy: a sync test against REGISTRY_STAMP.json is the drift alarm, not a live dependency.",
      "dependencies": [
        "tldraw@5.3.2",
        "@base-ui/react@1.8.0",
        "react-colorful",
        "cn",
        "lucide-react",
        "@tldraw/assets@5.3.2",
        "react-dom"
      ],
